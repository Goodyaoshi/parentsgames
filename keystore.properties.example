# Modelo de configuração de assinatura de release.
#
# 1. Copie este arquivo para "keystore.properties" (NÃO versionado).
# 2. Ajuste os valores conforme o seu keystore de upload.
# 3. Mantenha o .jks e estas senhas em local seguro (backup!). Perder o keystore
#    de upload não é fatal com o Play App Signing (dá para redefinir pela Play
#    Console), mas é um transtorno — guarde bem.
#
# O keystore de upload foi gerado com:
#   keytool -genkeypair -v -keystore fatimagames-upload-key.jks \
#     -alias fatimagames-upload -keyalg RSA -keysize 2048 -validity 10000

storeFile=fatimagames-upload-key.jks
storePassword=SUA_SENHA_DO_KEYSTORE
keyAlias=fatimagames-upload
keyPassword=SUA_SENHA_DA_CHAVE
